{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yidu-ZSC/nutri-sphere/blob/main/data/graph_schema.json",
  "title": "ClearDiet Graph Data",
  "description": "Schema for nodes and links conforming to docs/GRAPH_SCHEMA.md",
  "type": "object",
  "required": [
    "meta",
    "nodes",
    "links"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "data_version": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "group",
          "domain"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "diet_pattern",
              "food_category",
              "food",
              "nutrient",
              "compound",
              "metabolite",
              "mechanism",
              "disease",
              "biomarker"
            ]
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "protective",
              "risk",
              "neutral",
              "mixed"
            ]
          },
          "description": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mechanism_depth": {
            "type": "string",
            "enum": [
              "summary",
              "mechanism",
              "technical"
            ],
            "description": "Optional narrative depth for a mechanism node. Omitted means summary. Not GRADE, not ViewLayer, and not evidence strength."
          },
          "domain": {
            "type": "string",
            "enum": [
              "health",
              "environment",
              "culture"
            ],
            "description": "Theme domain for this node or link. Seed writes must be explicit. Omitted-at-runtime ⇒ health. Not ViewLayer, not GRADE, not audience."
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation",
          "direction",
          "evidence_type",
          "domain"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "protective",
              "risk",
              "neutral",
              "mixed"
            ]
          },
          "evidence_type": {
            "type": "string"
          },
          "strength": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "quantitative"
            ]
          },
          "source_file": {
            "type": "string"
          },
          "note_id": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "general",
              "deep_reader"
            ],
            "description": "Optional content fit for this edge. Omitted means general. Not a ViewLayer, not GRADE, and not evidence strength."
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "authors": {
                "type": "string"
              },
              "year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "doi": {
                "type": "string",
                "minLength": 1
              },
              "pmid": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "doi"
                ]
              },
              {
                "required": [
                  "pmid"
                ]
              }
            ]
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "description": "User-visible book or literature title. Required by validate-data for every link in schema 0.4."
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Book source id into data/sources.json. Required on non-literature links; forbidden on literature links."
          },
          "evidences": {
            "type": "array",
            "minItems": 1,
            "description": "Multi-evidence array (schema 0.5). Top-level excerpt/source_*/limitations/citation mirror evidences[0].",
            "items": {
              "type": "object",
              "required": [
                "excerpt",
                "limitations",
                "source_title",
                "source_file"
              ],
              "additionalProperties": true,
              "properties": {
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "limitations": {
                  "type": "string",
                  "minLength": 1
                },
                "source_title": {
                  "type": "string",
                  "minLength": 1
                },
                "source_file": {
                  "type": "string",
                  "minLength": 1
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "note_id": {
                  "type": "string"
                },
                "citation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "authors": {
                      "type": "string"
                    },
                    "year": {
                      "type": "integer",
                      "minimum": 1900,
                      "maximum": 2100
                    },
                    "doi": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pmid": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "doi"
                      ]
                    },
                    {
                      "required": [
                        "pmid"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "domain": {
            "type": "string",
            "enum": [
              "health",
              "environment",
              "culture"
            ],
            "description": "Theme domain for this node or link. Seed writes must be explicit. Omitted-at-runtime ⇒ health. Not ViewLayer, not GRADE, not audience."
          }
        },
        "additionalProperties": true
      }
    }
  }
}
